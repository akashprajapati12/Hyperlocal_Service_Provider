{
  "version": 2,
  "builds": [
    {
      "src": "Hyperlocal_Service_Provider/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.12"
      }
    }
  ],
  "buildCommand": "python3 manage.py collectstatic --noinput",
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "Hyperlocal_Service_Provider/wsgi.py"
    }
  ]
}
