{
  "version": 2,
  "builds": [
    {
      "src": "Hyperlocal_Service_Provider/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.12",
        "buildCommand": "bash build_files.sh"
      }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/media/(.*)", "dest": "/media/$1" },
    {
      "src": "/(.*)",
      "dest": "Hyperlocal_Service_Provider/wsgi.py"
    }
  ]
}
